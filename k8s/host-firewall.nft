#!/usr/sbin/nft -f
#
# Firewall cho vnutour-cp. Máy này bị DMZ trên router — router không cho forward
# riêng 443 nên mọi port của eth0 (192.168.1.110) đến thẳng từ internet. Không có
# lớp chặn nào phía trước, file này là lớp duy nhất.
#
#   eth0     192.168.1.110/24  — LAN nhà, và đường vào từ internet qua DMZ
#   enp6s19  10.10.10.11/24    — Proxmox SDN, mạng quản trị
#   cni0 / flannel.1 / veth*   — mạng nội bộ của k3s
#
# Chính sách: từ internet chỉ 443, và chỉ khi nguồn nằm trong dải Cloudflare.
# Mọi interface khác tin cậy hoàn toàn, nguồn trong LAN 192.168.1.0/24 vẫn mở —
# w1 nói chuyện với apiserver, kubelet và flannel VXLAN qua chính eth0, chặn dải
# đó là w1 rụng khỏi cụm.
#
# Vì sao là nftables table riêng chứ không phải ufw: k3s tự viết rất nhiều rule
# qua iptables-nft, ufw đặt FORWARD policy DROP làm hỏng mạng pod và reload của
# nó giẫm lên rule kube-proxy. Table riêng ở priority -10 chạy trước table của
# k3s, không đụng vào nó, và k3s restart cũng không xoá.
#
# Vì sao phải có cả chain forward: traffic vào 443 và mọi NodePort đều bị DNAT ở
# PREROUTING rồi đi tiếp sang pod qua FORWARD, không qua INPUT. Lọc mỗi INPUT là
# NodePort vẫn lọt.

table inet vnutour_fw
delete table inet vnutour_fw

table inet vnutour_fw {

	# Để rỗng ở đây và nạp bằng update-cloudflare-ips.sh, để danh sách IP là thứ
	# lấy từ Cloudflare chứ không phải thứ gõ tay rồi quên. Bản đã tải nằm ở
	# /var/lib/vnutour-fw/cloudflare.nft và được nạp lại mỗi lần khởi động, nên
	# set không bao giờ rỗng sau lần chạy đầu tiên.
	set cloudflare_v4 {
		type ipv4_addr
		flags interval
		auto-merge
	}

	set cloudflare_v6 {
		type ipv6_addr
		flags interval
		auto-merge
	}

	chain input {
		type filter hook input priority -10; policy drop;

		ct state established,related accept
		ct state invalid drop

		iifname "lo" accept

		# enp6s19 (quản trị) và toàn bộ interface của k3s. Cách này không phải
		# liệt kê veth mới mỗi lần có pod.
		iifname != "eth0" accept

		# ICMP giữ cho path MTU discovery hoạt động; thiếu nó là những kết nối
		# TLS lớn treo giữa chừng thay vì lỗi ngay.
		meta nfproto ipv4 icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } accept

		# NDP là thứ giữ địa chỉ IPv6 trên eth0; drop hết icmpv6 là mất v6.
		meta nfproto ipv6 icmpv6 type { echo-request, destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept

		# LAN: w1 (192.168.1.111) và máy quản trị trong nhà. ULA đi kèm vì eth0
		# cũng có IPv6 nội bộ; dải fd00::/8 không route được từ internet.
		ip saddr 192.168.1.0/24 accept
		ip6 saddr fde8:65d4:6f51::/48 accept

		# Chỉ cần nếu eth0 lấy IP bằng DHCP; vô hại khi IP tĩnh.
		udp sport 67 udp dport 68 accept

		# Từ internet: đúng một cổng, và chỉ từ Cloudflare. Gõ thẳng IP public
		# không vào được nữa, nên không ai bỏ qua được WAF và rate limit ở edge —
		# đó cũng là thứ bịt lỗ tự khai X-Forwarded-Proto mà use-forwarded-headers
		# mở ra. Không mở 80: Cloudflare "Always Use HTTPS" redirect ở edge và
		# không còn ACME nào cần đường đó.
		tcp dport 443 ip saddr @cloudflare_v4 accept
		tcp dport 443 ip6 saddr @cloudflare_v6 accept
	}

	chain forward {
		type filter hook forward priority -10; policy drop;

		ct state established,related accept
		ct state invalid drop

		# Pod đi ra ngoài, pod nói chuyện với nhau.
		iifname != "eth0" accept

		ip saddr 192.168.1.0/24 accept
		ip6 saddr fde8:65d4:6f51::/48 accept

		# Internet -> ingress: klipper-lb DNAT sang pod nhưng giữ nguyên cổng.
		tcp dport 443 ip saddr @cloudflare_v4 accept
		tcp dport 443 ip6 saddr @cloudflare_v6 accept
	}
}
