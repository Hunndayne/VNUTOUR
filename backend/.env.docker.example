# Copy to .env.docker and fill values. Do NOT commit real secrets.

# Discord
DISCORD_TOKEN=your_discord_bot_token
WELCOME_CHANNEL_ID=
LOG_CHANNEL_ID=
SUPPORT_ROLE=
# Team categories (you can provide multiple to bypass 50-channels/category limit)
CATEGORYIDFORTEAM=
# Or use multiple IDs (first valid will be used until full, then next):
# CATEGORYIDFORTEAM1=
# CATEGORYIDFORTEAM2=
# CATEGORYIDFORTEAM3=
# CATEGORYIDFORTEAM4=

# MongoDB
MongoDB=mongodb+srv://user:pass@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=vnutour

# Google Sheets (OPTIONAL — MongoDB is now the source of truth)
# Sheet import/export are toggled via System Settings (GET/PUT /api/settings):
#   sheet_import_enabled, sheet_checkin_export_enabled  (both default OFF)
# Only fill these if you turn those settings ON.
GoogleSheetAPI=your_public_api_key_or_leave_blank_if_using_service_account
GoogleSheetID=your_sheet_id
GOOGLE_SHEET_TAB=
GOOGLE_SHEET_RANGE=A1:K

# Option A: Use Docker secret (recommended)
# Set in docker-compose.yml: GOOGLE_CREDENTIALS_JSON=/run/secrets/google_credentials

# Option B: Bind mount credentials and set a path inside container, e.g.
# GOOGLE_CREDENTIALS_JSON=/app/credentials/service_account.json
# or use base64 to avoid mounting a file:
# GOOGLE_CREDENTIALS_BASE64=

# Sync settings
SHEET_SYNC_INTERVAL=60

# ffmpeg path inside container is set via docker-compose.yml (FFMPEG_EXE=ffmpeg)
