# Copy this file to .env.docker. Never commit the real file.

# Compose
IMAGE_TAG=latest
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Cloudflare Tunnel, required by docker-compose.prod.yml. Create the tunnel in
# the Zero Trust dashboard and route the public hostname to http://frontend:80.
CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL
DB_NAME=vnutour
DB_USER=vnutour
DB_PASSWORD=replace-with-a-long-random-password

# Django production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
TRUST_PROXY_HEADERS=1
CORS_ALLOW_ALL=0
CORS_ALLOW_CREDENTIALS=0
# Same-origin deployment does not require CORS. Add origins only if a separate
# frontend domain must call the API directly.
CORS_ALLOWED_ORIGINS=
AUTH_TOKEN_MAX_AGE_SECONDS=86400

# Public Google OAuth client ID (also embedded into the frontend at build time).
GOOGLE_CLIENT_ID=

# Discord bot. Keep this off by default for local Docker development unless you
# have a real Discord bot token and guild configured.
RUN_DISCORD_BOT=0
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_SYNC_INTERVAL=10
DISCORD_COMMAND_PREFIX=!

# Discord "Connect" OAuth2 (web button that replaces typing !assign). The API
# needs DISCORD_TOKEN + DISCORD_GUILD_ID above too, to check guild membership.
# CLIENT_ID is public; keep CLIENT_SECRET secret. Redirect URIs are an allowlist
# (comma-separated) and must match the ones registered in the Discord Developer
# Portal exactly — one per environment, each ending in /participant.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URIS=https://vnutour.example.com/participant,http://localhost:5173/participant
# Permanent server invite shown in the "join the server first" step.
DISCORD_INVITE_URL=
WEB_BASE_URL=https://vnutour.example.com
WELCOME_CHANNEL_ID=
LOG_CHANNEL_ID=
SUPPORT_CHANNEL_ID=
START_HERE_CHANNEL_ID=
RULES_CHANNEL_ID=
# Comma-separated Discord category IDs used for private team channels.
TEAM_CATEGORY_IDS=

# SMTP / email worker
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
EMAIL_QUEUE_INTERVAL_SECONDS=10
EMAIL_QUEUE_MAX_ATTEMPTS=5

# Database dumps. Retention counts files kept in backend/backups.
BACKUP_RETENTION=14
BACKUP_PREFIX=db-backups

# Cloudflare R2 (optional; local media volume is used when omitted)
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
