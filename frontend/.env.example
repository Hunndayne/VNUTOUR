# Copy to .env for local development. Never commit the real file.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle, and
# whatever it does expose is readable by anyone loading the page. Nothing
# secret belongs in this file — server-side credentials such as the Discord
# bot token live in backend/.env and are never read by the frontend.

# Backend API base URL. The Docker image defaults to /api, which the Nginx
# reverse proxy forwards to Django; point this at the dev server when running
# `npm run dev` outside a container.
VITE_API_BASE_URL=http://localhost:8080

# Public Google OAuth client ID. Public by design, but must match the value
# baked into the production image at build time.
VITE_GOOGLE_CLIENT_ID=
